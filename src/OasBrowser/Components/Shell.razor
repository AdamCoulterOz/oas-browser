@implements IAsyncDisposable
@inject SpecStore Store
@inject HashRouter Router
@inject IJSRuntime Js

@* The rail and the drawer show the same tree. Above keel's Lg width it is a
   sticky column; below it, KeelNavDrawer carries it. *@

<div class="shell">
    <header class="shell__header">
        <KeelNavBar class="appbar" Collapse="Size.Lg" DrawerOpen="_navOpen"
                    OnOpenDrawer="ToggleNav" MenuLabel="Open navigation">
            <Brand>
                <a class="brand" href="#/" @onclick:preventDefault @onclick="GoOverview">
                    <span class="brand__long">Power Platform APIs</span>
                    <span class="brand__short">PP APIs</span>
                </a>

                @if (_catalogue.Count > 1)
                {
                    <KeelSelect class="appbar__select" TValue="string" Size="Size.Sm"
                                Value="@(_current?.Id)" ValueChanged="OnSpecChanged" aria-label="Select API">
                        @foreach (var entry in _catalogue)
                        {
                            <option value="@entry.Id">@entry.Title</option>
                        }
                    </KeelSelect>
                }
            </Brand>

            <ChildContent>
                @if (_current is not null)
                {
                    <a href="@_current.Repo" target="_blank" rel="noopener"
                       aria-label="Source on GitHub" title="Source on GitHub">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                        </svg>
                    </a>
                }
            </ChildContent>
        </KeelNavBar>
    </header>

    <div class="shell__main">
        <div class="layout">
            <nav class="rail" aria-label="API navigation">
                @if (_spec is not null)
                {
                    <NavTree Spec="_spec" Current="_route" OnNavigate="NavigateAsync" />
                }
            </nav>

            <KeelNavDrawer @bind-Open="_navOpen" Side="Side.Left" Title="API navigation">
                <Header>Power Platform APIs</Header>
                <ChildContent>
                    @if (_spec is not null)
                    {
                        <div class="rail__drawer-body">
                            <NavTree Spec="_spec" Current="_route" OnNavigate="NavigateAsync" />
                        </div>
                    }
                </ChildContent>
            </KeelNavDrawer>

            <main class="main">
                @if (_error is not null)
                {
                    <div class="state">
                        <p><strong>Could not load the API.</strong></p>
                        <p>@_error</p>
                    </div>
                }
                else if (_spec is null)
                {
                    <div class="state">
                        <KeelSpinner class="state__spinner" Diameter="22"
                                     Label="@($"Loading {_current?.Title ?? "spec"}")" />
                        Loading @(_current?.Title ?? "spec")…
                    </div>
                }
                else
                {
                    @switch (_route.Kind)
                    {
                        case RouteKind.Operation when FindOperation(_route.Id) is { } op:
                            <OperationView Spec="_spec" Operation="op" OnNavigate="NavigateAsync" />
                            break;
                        case RouteKind.Resource when _route.Id is { } tag:
                            <ResourcePage Spec="_spec" Name="@tag" OnNavigate="NavigateAsync" />
                            break;
                        case RouteKind.Schema when _route.Id is { } id && _spec.Schemas.ContainsKey(id):
                            <SchemaPage Spec="_spec" Name="@id" OnNavigate="NavigateAsync" />
                            break;
                        default:
                            <OverviewPage Spec="_spec" OnNavigate="NavigateAsync" />
                            break;
                    }
                }
            </main>
        </div>
    </div>
</div>

@code {
    private List<SpecEntry> _catalogue = new();
    private SpecEntry? _current;
    private OpenApiSpec? _spec;
    private Route _route = Route.Overview;
    private string? _error;
    private bool _navOpen;

    protected override async Task OnInitializedAsync()
    {
        Router.Changed += OnRouteChanged;
        try
        {
            _catalogue = (await Store.LoadCatalogueAsync()).ToList();
            await Router.InitialiseAsync();
            _route = Router.Current;
            _current = _catalogue.FirstOrDefault();
            if (_current is not null) _spec = await Store.LoadSpecAsync(_current);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OnRouteChanged(Route route)
    {
        _route = route;
        StateHasChanged();
    }

    private async Task NavigateAsync(Route route)
    {
        await Router.GoAsync(route);
        _route = route;
        _navOpen = false;
        await Router.ScrollTopAsync();
        StateHasChanged();
    }

    private Task GoOverview() => NavigateAsync(Route.Overview);

    private async Task OnSpecChanged(string? id)
    {
        var entry = _catalogue.FirstOrDefault(x => x.Id == id);
        if (entry is null || entry.Id == _current?.Id) return;

        // Clearing _spec puts the loading state on screen. No StateHasChanged
        // is needed: Blazor renders when an async handler yields at its first
        // await, which is the load below.
        _current = entry;
        _spec = null;
        _error = null;

        try { _spec = await Store.LoadSpecAsync(entry); }
        catch (Exception ex) { _error = ex.Message; }

        await NavigateAsync(Route.Overview);
    }

    private Operation? FindOperation(string? id) =>
        id is null ? null : _spec?.Operations.FirstOrDefault(o => o.OperationId == id);

    private void ToggleNav() => _navOpen = !_navOpen;

    public async ValueTask DisposeAsync()
    {
        Router.Changed -= OnRouteChanged;
        await Router.DisposeAsync();
    }
}
