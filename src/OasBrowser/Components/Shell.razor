@implements IAsyncDisposable
@inject SpecStore Store
@inject CoverageStore Coverage
@inject HashRouter Router
@inject IJSRuntime Js

@* The rail and the drawer show the same tree. Above keel's Lg width it is a
   sticky column; below it, KeelNavDrawer carries it. *@

@* The tab title is the corpus's, so it has to be written after the catalogue
   loads rather than in index.html. PageTitle is how that happens without any
   JS of ours: Program.cs already mounts HeadOutlet, and this re-renders with
   the brand once Store.Brand stops being the neutral default. *@
<PageTitle>@Brand.Long</PageTitle>

<div class="shell">
    <header class="shell__header">
        <KeelNavBar class="appbar" Collapse="Size.Lg" DrawerOpen="_navOpen"
                    OnOpenDrawer="ToggleNav" MenuLabel="Open navigation">
            <Brand>
                @* Both names are the catalogue's. The long/short pair is the
                   bar's way of not wrapping onto two lines on a phone, which
                   is why a corpus gets to declare its own abbreviation rather
                   than have one truncated for it. The description is the
                   corpus's one-line account of itself and there is nowhere
                   else on screen for it, so it becomes the tooltip. *@
                <a class="brand" href="#/" title="@Brand.Description"
                   @onclick:preventDefault @onclick="GoOverview">
                    <span class="brand__long">@Brand.Long</span>
                    <span class="brand__short">@Brand.Short</span>
                </a>

                @* Where the catalogue came from, beside the name it chose for
                   itself. Every other word in this bar is the catalogue's own
                   claim, so a catalogue served from anywhere can put any name
                   here on somebody else's domain; the origin is the one thing
                   on screen an impersonator does not get to write. See
                   SpecStore.CatalogueOrigin for why this rather than an
                   allow-list.

                   In the bar rather than in a tooltip, because a tooltip is
                   precisely what somebody being deceived will not hover over,
                   and it is shown for the same-origin default too. Only ever
                   appearing when the catalogue is remote would make its
                   absence the signal, and absence is the easy thing to
                   arrange: a reader who has never seen this marker cannot
                   notice it missing. Showing it always is also one rule rather
                   than two, with nothing to get wrong about which origin
                   counts as ours.

                   The origin, not the whole url. That is a shortening from the
                   end, which drops the path and keeps the host entire; cutting
                   a long hostname short instead would hide the registrable
                   domain, which is the half a lookalike host is built out of.
                   It does not shrink for the same reason: the select beside it
                   is resizable content and this is not.

                   The title says the whole sentence for a reader who does not
                   recognise a bare origin. It is a supplement to the visible
                   text and never the only place this appears. *@
                @if (Store.CatalogueOrigin is { } origin)
                {
                    @* The chip shows the origin, which is the security boundary
                       and the thing a lookalike host cannot forge. The tooltip
                       carries the whole URL, because two corpora published from
                       one account share an origin and differ only in path, and
                       the chip alone then cannot say which of them is loaded.
                       Repeating the origin there, as this did, answered the
                       question the chip had already answered. *@
                    <KeelChip class="brand-origin" Emphasis="Emphasis.Quiet" Mono="true"
                              title="@($"Catalogue fetched from {Store.CatalogueUrl ?? origin}")">@origin</KeelChip>
                }

                @if (_catalogue.Count > 1)
                {
                    <KeelSelect class="appbar__select" TValue="string" Size="Size.Sm"
                                Value="@(_current?.Id)" ValueChanged="OnSpecChanged" aria-label="Select API">
                        @foreach (var entry in _catalogue)
                        {
                            <option value="@entry.Id">@entry.Title</option>
                        }
                    </KeelSelect>
                }
            </Brand>

            <ChildContent>
                @* The way in to the coverage view, and only when something has
                   named a mapping. A link to a page that would say "no mapping"
                   on every corpus in the world is chrome; a link that appears
                   because somebody published a claim about this corpus is the
                   notice that the claim exists. Shown for a refusal too: a
                   mapping that was named and is being refused is exactly the
                   thing a reader most needs to be able to go and read. *@
                @if (Coverage.Declared && _current is not null)
                {
                    <a class="appbar__coverage" href="@CoverageHash"
                       @onclick:preventDefault @onclick="GoCoverage">Coverage</a>
                }

                @if (_current is not null)
                {
                    <a href="@_current.Repo" target="_blank" rel="noopener"
                       aria-label="Source on GitHub" title="Source on GitHub">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                        </svg>
                    </a>
                }
            </ChildContent>
        </KeelNavBar>
    </header>

    <div class="shell__main">
        <div class="layout">
            <nav class="rail" aria-label="API navigation">
                @if (_spec is not null)
                {
                    <NavTree Spec="_spec" Current="_route" OnNavigate="NavigateAsync" />
                }
            </nav>

            <KeelNavDrawer @bind-Open="_navOpen" Side="Side.Left" Title="API navigation">
                <Header>@Brand.Long</Header>
                <ChildContent>
                    @* The bar hides its links behind the burger below keel's Lg
                       width, so a link that lives only there is a link a phone
                       cannot reach. Repeated here rather than moved, because on
                       a wide screen the bar is where it belongs. *@
                    @if (Coverage.Declared && _current is not null)
                    {
                        <a class="rail__drawer-link" href="@CoverageHash"
                           @onclick:preventDefault @onclick="GoCoverage">Coverage</a>
                    }

                    @if (_spec is not null)
                    {
                        <div class="rail__drawer-body">
                            <NavTree Spec="_spec" Current="_route" OnNavigate="NavigateAsync" />
                        </div>
                    }
                </ChildContent>
            </KeelNavDrawer>

            <main class="main">
                @* A spec whose id collides with a route segment has no URL that
                   can name it, so it cannot be linked to and the picker sends a
                   reader somewhere else. That is a defect in the catalogue and
                   the browser is the only party that can detect it, because the
                   reserved set is derived from this app's route table and grows
                   when a route kind is added.

                   On the page rather than in a console, because the person who
                   can fix it is whoever publishes the catalogue and they are
                   more likely to be reading this than a devtools panel. Above
                   the content rather than instead of it: the other specs work
                   and taking them away would be punishing a reader for someone
                   else's naming. *@
                @if (Store.CollidingSpecIds.Count > 0)
                {
                    <KeelCallout Tone="Tone.Warning" Title="This catalogue names a spec the URL cannot reach">
                        <p>
                            @string.Join(", ", Store.CollidingSpecIds)
                            @(Store.CollidingSpecIds.Count == 1 ? " is" : " are")
                            also the name of a route segment, so
                            <code>#/@(Store.CollidingSpecIds[0])</code> is read as a page
                            rather than as a spec. Rename it in the catalogue.
                        </p>
                    </KeelCallout>
                }

                @if (_error is not null)
                {
                    <div class="state">
                        <p><strong>Could not load the API.</strong></p>
                        <p>@_error</p>
                    </div>
                }
                else if (_spec is null)
                {
                    <div class="state">
                        <KeelSpinner class="state__spinner" Diameter="22"
                                     Label="@($"Loading {_current?.Title ?? "spec"}")" />
                        Loading @(_current?.Title ?? "spec")…
                    </div>
                }
                else
                {
                    @switch (_route.Kind)
                    {
                        case RouteKind.Operation when FindOperation(_route.Id) is { } op:
                            <OperationView Spec="_spec" Operation="op" OnNavigate="NavigateAsync" />
                            break;
                        case RouteKind.Resource when _route.Id is { } tag:
                            <ResourcePage Spec="_spec" Name="@tag" OnNavigate="NavigateAsync" />
                            break;
                        case RouteKind.Schema when _route.Id is { } id && _spec.Schemas.ContainsKey(id):
                            <SchemaPage Spec="_spec" Name="@id" OnNavigate="NavigateAsync" />
                            break;
                        case RouteKind.Coverage when _current is not null:
                            @* The catalogue id, not the spec's own title. A
                               mapping's `spec` field names a catalogue entry,
                               and the title inside the document is a different
                               string chosen by a different person. *@
                            <CoveragePage Spec="_spec" SpecId="@_current.Id" OnNavigate="NavigateAsync" />
                            break;
                        default:
                            <OverviewPage Spec="_spec" OnNavigate="NavigateAsync" />
                            break;
                    }
                }
            </main>
        </div>
    </div>
</div>

@code {
    // Read through rather than copied, so the neutral default before the
    // catalogue arrives and the corpus's own name after it are the same
    // expression and no render can show a stale one.
    private Branding Brand => Store.Brand;

    private List<SpecEntry> _catalogue = new();
    private SpecEntry? _current;
    private OpenApiSpec? _spec;
    private Route _route = Route.Overview;
    private string? _error;
    private bool _navOpen;

    protected override async Task OnInitializedAsync()
    {
        Router.Changed += OnRouteChanged;
        try
        {
            _catalogue = (await Store.LoadCatalogueAsync()).ToList();

            // After the catalogue, because the catalogue is one of the two
            // places a mapping url comes from, the thing a relative one
            // resolves against, and the other half of the agreement check.
            // Awaited rather than left running: nothing is fetched at all
            // unless a mapping was named, and when one was, it was named by
            // the reader or by the corpus and the whole app is about to want
            // to know whether it loaded.
            await Coverage.LoadAsync();

            await Router.InitialiseAsync();
            await ApplyRouteAsync(Router.Current);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async void OnRouteChanged(Route route)
    {
        // Back and forward can move between specs, so the route decides which
        // spec is loaded rather than only which page of it is shown.
        await ApplyRouteAsync(route);
        StateHasChanged();
    }

    /// <summary>
    /// Makes the app match a route, loading a different spec if the route names
    /// one. The route is the source of truth for which spec is on screen; it
    /// was the catalogue's first entry, unconditionally, which is why nine of
    /// ten specs could not be linked to.
    /// </summary>
    private async Task ApplyRouteAsync(Route route)
    {
        _route = route;

        var wanted = Store.Resolve(route.SpecId);
        if (wanted is null)
        {
            // A route naming a spec the catalogue does not have. Say so rather
            // than quietly showing a different one: the reader asked for
            // something specific and a substitution is indistinguishable from
            // having got what they asked for.
            _error = route.SpecId is { } missing
                ? $"No spec called \"{missing}\" in this catalogue."
                : "This catalogue has no specs in it.";
            _spec = null;
            return;
        }

        if (wanted.Id == _current?.Id && _spec is not null) return;

        _current = wanted;
        _spec = null;
        _error = null;
        StateHasChanged();

        try { _spec = await Store.LoadSpecAsync(wanted); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task NavigateAsync(Route route)
    {
        // In-page navigation means "this, in the spec I am looking at", so the
        // shell is what attaches the spec. A nav-tree click does not have to
        // know where it is, and the URL still names the spec, which is the
        // whole point of the change.
        var qualified = route.SpecId is null ? route with { SpecId = _current?.Id } : route;

        await ApplyRouteAsync(qualified);
        await Router.GoAsync(qualified);
        _navOpen = false;
        await Router.ScrollTopAsync();
        StateHasChanged();
    }

    private Task GoOverview() => NavigateAsync(new Route(RouteKind.Overview, null, _current?.Id));

    // Coverage is about the whole spec rather than one thing in it, so the
    // route carries no id. Route writes the hash; the anchor carries it so the
    // link behaves like a link for middle-click and copy, and the click handler
    // keeps it in-app.
    private string CoverageHash => new Route(RouteKind.Coverage, null, _current?.Id).ToHash();

    private Task GoCoverage() => NavigateAsync(new Route(RouteKind.Coverage, null, _current?.Id));

    private Task OnSpecChanged(string? id) =>
        id is null || id == _current?.Id
            ? Task.CompletedTask
            // Switching spec is a navigation, so it goes through the router and
            // changes the URL. It used to change what rendered and not the URL,
            // so reloading or sharing sent the reader back to spec zero.
            : NavigateAsync(new Route(RouteKind.Overview, null, id));

    private Operation? FindOperation(string? id) =>
        id is null ? null : _spec?.Operations.FirstOrDefault(o => o.OperationId == id);

    private void ToggleNav() => _navOpen = !_navOpen;

    public async ValueTask DisposeAsync()
    {
        Router.Changed -= OnRouteChanged;
        await Router.DisposeAsync();
    }
}
