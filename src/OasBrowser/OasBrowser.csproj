<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The assembly name and root namespace both derive from this file's name,
       so the file name is the only place OasBrowser is spelled. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Fingerprinted asset names. Stable names break returning visitors on
         every deploy: the browser keeps a cached copy of the one assembly that
         changed, its hash no longer matches, and the app fails to boot until a
         hard refresh. -->
    <WasmFingerprintAssets>true</WasmFingerprintAssets>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-preview.7.26381.103" PrivateAssets="all" />
    <PackageReference Include="Keel" Version="0.4.2" />
  </ItemGroup>

</Project>
