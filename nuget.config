<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Keel is a private package owned by the keel repository. Restoring it
         needs credentials, and the two cases fail identically with NU1301 403:
         a developer needs a token carrying read:packages (gh auth refresh
         -h github.com -s read:packages), and a workflow in this repository
         needs the package to grant this repository access under Manage Actions
         access, which is not automatic for a package owned by another repo. -->
    <add key="keel" value="https://nuget.pkg.github.com/AdamCoulterOz/index.json" />
  </packageSources>
</configuration>
