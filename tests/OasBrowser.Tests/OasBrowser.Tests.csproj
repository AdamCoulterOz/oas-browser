<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The routing contract, the description renderer and the coverage mapping
       are pure logic with no Blazor in them, so they are compiled in directly
       rather than by referencing the app. Referencing the app would drag in
       Keel, which needs a private feed, and would make a test run that proves
       nothing about Keel fail when a token expires. Markdown.cs adds no
       dependency beyond Route.cs and System.Text, and CoverageMap.cs adds none
       beyond System.Text.Json, so this project still restores from nuget.org
       alone.

       CoverageStore.cs is deliberately absent: it needs NavigationManager and
       HttpClient. The check that must not be wrong, whether a mapping is about
       the catalogue actually loaded, lives in CoverageMap.cs for that reason,
       so the thing worth testing is the thing this project can reach. -->
  <ItemGroup>
    <Compile Include="../../src/OasBrowser/Services/Route.cs" />
    <Compile Include="../../src/OasBrowser/Rendering/Markdown.cs" />
    <Compile Include="../../src/OasBrowser/Model/CoverageMap.cs" />
  </ItemGroup>

</Project>
