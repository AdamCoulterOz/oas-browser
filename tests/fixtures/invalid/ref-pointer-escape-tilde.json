{
  "openapi": "3.0.3",
  "info": {
    "title": "Riverside Library: pointers needing ~0 escaping",
    "version": "1.0.0"
  },
  "paths": {
    "/books/{bookId}": {
      "get": {
        "operationId": "getBook",
        "parameters": [
          {
            "name": "bookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The current record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book~0Draft"
                }
              }
            }
          },
          "202": {
            "description": "The record as it will be after the pending amendment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book~01Draft"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book~Draft": {
        "type": "object",
        "description": "Reached by decoding ~0 to a tilde.",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Book~1Draft": {
        "type": "object",
        "description": "Reached by decoding ~01 to ~1, and NOT by decoding it to a slash.",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        }
      }
    }
  }
}
