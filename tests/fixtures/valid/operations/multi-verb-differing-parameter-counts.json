{
  "openapi": "3.0.3",
  "info": {
    "title": "Riverside Library: one path, four verbs, four different parameter counts",
    "version": "1.0.0"
  },
  "paths": {
    "/loans/{loanId}": {
      "get": {
        "operationId": "getLoan",
        "summary": "Fetch one loan (3 parameters)",
        "parameters": [
          {
            "name": "loanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "expand",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The loan."
          }
        }
      },
      "put": {
        "operationId": "replaceLoan",
        "summary": "Replace one loan (2 parameters)",
        "parameters": [
          {
            "name": "loanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dueOn": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The replaced loan."
          }
        }
      },
      "patch": {
        "operationId": "renewLoan",
        "summary": "Renew one loan (1 parameter)",
        "parameters": [
          {
            "name": "loanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The renewed loan."
          }
        }
      },
      "delete": {
        "operationId": "returnLoan",
        "summary": "Return the item and end the loan (4 parameters)",
        "parameters": [
          {
            "name": "loanId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "damaged",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "returnedAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "X-Desk-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Loan closed."
          }
        }
      }
    }
  }
}
