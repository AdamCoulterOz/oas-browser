{
  "openapi": "3.0.3",
  "info": {
    "title": "Riverside Library: a JSON pointer needing ~1 escaping",
    "version": "1.0.0"
  },
  "paths": {
    "/books": {
      "get": {
        "operationId": "listBooks",
        "responses": {
          "200": {
            "description": "Matching books.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/books/recently-returned": {
      "get": {
        "operationId": "listRecentlyReturnedBooks",
        "responses": {
          "200": {
            "$ref": "#/paths/~1books/get/responses/200"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  }
}
