{
  "openapi": "3.0.3",
  "info": {
    "title": "Riverside Library: a path item written as a $ref",
    "version": "1.0.0"
  },
  "paths": {
    "/books": {
      "get": {
        "summary": "List books",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching books."
          }
        }
      }
    },
    "/titles": {
      "$ref": "#/paths/~1books"
    }
  }
}
