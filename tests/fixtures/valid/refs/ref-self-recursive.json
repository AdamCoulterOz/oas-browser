{
  "openapi": "3.0.3",
  "info": {
    "title": "Riverside Library: a schema that references itself",
    "version": "1.0.0"
  },
  "paths": {
    "/shelves/{shelfId}": {
      "get": {
        "operationId": "getShelf",
        "parameters": [
          {
            "name": "shelfId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The shelf and everything below it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shelf"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Shelf": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Shelf"
            }
          }
        }
      }
    }
  }
}
