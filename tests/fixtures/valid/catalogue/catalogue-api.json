{
  "openapi": "3.0.3",
  "info": {
    "title": "Riverside Catalogue API",
    "version": "1.0.0",
    "description": "What the library holds. First entry in specs.json."
  },
  "paths": {
    "/items/{itemId}": {
      "get": {
        "operationId": "getItem",
        "summary": "Fetch one catalogue record",
        "tags": [
          "Catalogue"
        ],
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The catalogue record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "description": "A catalogue record. Note the properties: this is the catalogue spec's Item.",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "shelfMark": {
            "type": "string"
          }
        }
      }
    }
  }
}
